# =============================================================
# LOCAL REMOTE-DEBUG ONLY
# -------------------------------------------------------------
# These variables are used ONLY when a contributor runs the
# plugin locally with `python -m main` and connects it to a
# hosted Dify workspace through the remote-debug channel.
#
# End users DO NOT need this file. A packaged .difypkg install
# has `.env` excluded via `.difyignore`. Users only fill their
# own API Key on the Dify provider configuration page.
#
# To enable local debugging:
#   1. Copy this file to `.env`
#   2. Replace each placeholder with the values issued by your
#      Dify workspace -> "Plugin" -> "Debug" panel.
#   3. Never commit the real `.env` file.
# =============================================================

INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug.dify.ai:5003
REMOTE_INSTALL_HOST=debug.dify.ai
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=<paste-your-debug-key-here>
